{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper.tips/schema/stack.json",
  "title": "Builder stack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "outcome", "blocks", "source", "paper_related", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "role"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "url", "author"],
      "properties": {
        "platform": { "const": "x" },
        "url": {
          "type": "string",
          "pattern": "^https://(x|twitter)\\.com/[^/]+/status/[0-9]+"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handle"],
          "properties": {
            "handle": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "profile_url": { "type": "string", "format": "uri" }
          }
        },
        "posted_at": { "type": "string", "format": "date-time" },
        "quote": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "impressions": { "type": "integer", "minimum": 0 },
            "likes": { "type": "integer", "minimum": 0 },
            "bookmarks": { "type": "integer", "minimum": 0 },
            "replies": { "type": "integer", "minimum": 0 },
            "reposts": { "type": "integer", "minimum": 0 },
            "captured": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "paper_related": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["verified", "inferred", "proposed"]
    }
  }
}
