{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper.tips/schema/block.json",
  "title": "Builder stack block",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "summary", "links"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["app", "mcp", "agent", "model", "skill", "host", "service", "other"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": { "type": "string", "format": "uri" },
        "docs": { "type": "string", "format": "uri" },
        "mcp": { "type": "string", "format": "uri" },
        "github": { "type": "string", "format": "uri" }
      }
    }
  }
}
